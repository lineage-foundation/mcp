# Lineage SDK
LINEAGE_PASSPHRASE="change-me"
LINEAGE_STORAGE_HOST="https://storage.lineage.to"
LINEAGE_MEMPOOL_HOST="https://mempool.lineage.to"
LINEAGE_VALENCE_HOST="https://valence.lineage.to"
# Optional: sent as the x-api-key header on every SDK request
LINEAGE_API_KEY=""

# Block explorer (read-only REST API)
LINEAGE_EXPLORER_URL="https://explorer.lineage.to"
LINEAGE_EXPLORER_TIMEOUT_S="10"

# MCP Server (dev)
MCP_ALLOW_ORIGINS="*"
MCP_DEV_AUTH_TOKEN=""
REQUEST_TIMEOUT_S="30"
MAX_BODY_MB="5"

# App
LOG_LEVEL="INFO"
